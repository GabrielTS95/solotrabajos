# Agente bajo prueba
# Proveedores soportados: dify, http
AGENT_PROVIDER=dify

# Adaptador Dify
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your-dify-key

# Ejemplo para un agente HTTP generico
# AGENT_PROVIDER=http
# AGENT_ENDPOINT=https://your-agent.example.com/chat
# AGENT_API_KEY=your-agent-key
# AGENT_METHOD=POST
# AGENT_QUERY_FIELD=query
# AGENT_USER_FIELD=user
# AGENT_ANSWER_PATH=answer
# AGENT_AUTH_HEADER=Authorization
# AGENT_AUTH_SCHEME=Bearer

# Modelo juez Foundry
FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=your-foundry-key
FOUNDRY_MODEL=your-deployment-name
FOUNDRY_JSON_MODE=true

# Ejecucion
REQUEST_TIMEOUT_SECONDS=45
MAX_USER_INPUT_CHARS=12000
MAX_AGENT_OUTPUT_CHARS=20000
REPORT_DIRECTORY=resultados
